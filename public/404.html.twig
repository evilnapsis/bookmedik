{% extends "layouts/main.html.twig" %}

{% block title %}404 Página No Encontrada - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item active"><span>404 Error</span></li>
{% endblock %}

{% block content %}
<div class="text-center py-5">
    <div class="display-1 fw-bold text-primary mb-3">404</div>
    <h3 class="fw-bold mb-2">¡Página No Encontrada!</h3>
    <p class="text-body-secondary mb-4">La ruta o recurso al que intentas acceder no existe en el sistema BookMedik.</p>
    <a href="{{ base_url }}/" class="btn btn-primary px-4"><i class="bi bi-house me-2"></i> Regresar al Inicio</a>
</div>
{% endblock %}
