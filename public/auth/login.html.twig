<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>Iniciar Sesión - BookMedik v5</title>
    
    <!-- Google Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- CoreUI v5 Main Styles -->
    <link rel="stylesheet" href="{{ base_url }}/assets/coreui/vendors/simplebar/css/simplebar.css">
    <link rel="stylesheet" href="{{ base_url }}/assets/coreui/css/style.css">

    <script src="{{ base_url }}/assets/coreui/js/config.js"></script>
    <script src="{{ base_url }}/assets/coreui/js/color-modes.js"></script>

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body>
    <div class="bg-body-tertiary min-vh-100 d-flex flex-row align-items-center">
        <div class="container" style="max-width: 30rem">
            <div class="d-flex flex-column gap-4">

                <!-- Logo & Heading -->
                <div class="text-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 64px; height: 64px; font-size: 32px;">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-1">BookMedik <span class="badge bg-primary text-white fs-6">v5</span></h2>
                    <p class="text-body-secondary small">Sistema de Control y Gestión Médica</p>
                </div>

                <!-- Tarjeta de Login -->
                <div class="card p-4 shadow-sm border-0">
                    <div class="card-body d-flex flex-column gap-3 p-2">
                        <h4 class="h5 fw-bold text-center mb-3">Iniciar Sesión</h4>
                        
                        <form action="{{ base_url }}/login" method="POST" class="d-flex flex-column gap-3">
                            {{ csrf_field() }}

                            <div>
                                <label class="form-label font-weight-bold" for="username">Usuario o Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary"><i class="bi bi-person-fill text-muted"></i></span>
                                    <input class="form-control ps-3" id="username" type="text" name="username" placeholder="ej. admin" required autofocus>
                                </div>
                            </div>

                            <div>
                                <label class="form-label font-weight-bold" for="password">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary"><i class="bi bi-lock-fill text-muted"></i></span>
                                    <input class="form-control ps-3" id="password" type="password" name="password" placeholder="••••••••" required>
                                </div>
                            </div>

                            <button class="btn btn-primary py-2 font-weight-bold shadow-sm mt-2" type="submit">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Acceder al Sistema
                            </button>
                        </form>
                    </div>
                </div>

                <div class="text-center text-body-secondary small">
                    BookMedik v5 &copy; 2026 - Evilnapsis
                </div>
            </div>
        </div>
    </div>

    <!-- CoreUI JS & SweetAlert2 -->
    <script src="{{ base_url }}/assets/coreui/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        {% for type, message in flashes %}
            Swal.fire({
                icon: '{{ type == "error" ? "error" : (type == "success" ? "success" : "info") }}',
                title: '{{ type == "error" ? "¡Atención!" : (type == "success" ? "¡Operación Exitosa!" : "Información") }}',
                text: '{{ message }}',
                confirmButtonColor: '#321fdb',
                timer: 4000,
                timerProgressBar: true
            });
        {% endfor %}
    </script>
</body>
</html>
