{% extends "layouts/main.html.twig" %}

{% block title %}Expediente Paciente - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ base_url }}/pacients">Pacientes</a></li>
<li class="breadcrumb-item active"><span>Expediente</span></li>
{% endblock %}

{% block content %}
<div class="mb-4">
    <a href="{{ base_url }}/pacients" class="text-decoration-none text-body-secondary"><i class="bi bi-arrow-left me-1"></i> Volver a Pacientes</a>
    <div class="d-flex justify-content-between align-items-center mt-2">
        <h3 class="fw-bold mb-0">Expediente Médico</h3>
        <a href="{{ base_url }}/pacient/{{ pacient.id }}/edit" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i> Editar Información</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card p-4 border-0 shadow-sm text-center mb-4">
            <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 36px;">
                <i class="bi bi-person-circle"></i>
            </div>
            <h4 class="fw-bold mb-1">{{ pacient.name }} {{ pacient.lastname }}</h4>
            <p class="text-body-secondary small mb-3">Expediente: #{{ pacient.no ?: pacient.id }}</p>

            <div class="text-start border-top pt-3">
                <p class="mb-2"><strong>Género:</strong> {{ pacient.gender == 'm' ? 'Masculino' : 'Femenino' }}</p>
                <p class="mb-2"><strong>Fecha de Nacimiento:</strong> {{ pacient.day_of_birth ?: 'N/A' }}</p>
                <p class="mb-2"><strong>Email:</strong> {{ pacient.email ?: 'N/A' }}</p>
                <p class="mb-2"><strong>Teléfono:</strong> {{ pacient.phone ?: 'N/A' }}</p>
                <p class="mb-0"><strong>Dirección:</strong> {{ pacient.address ?: 'N/A' }}</p>
            </div>
        </div>

        <div class="card p-4 border-0 shadow-sm">
            <h5 class="fw-bold mb-3"><i class="bi bi-journal-medical text-primary me-2"></i> Antecedentes</h5>
            <div class="mb-3">
                <h6 class="fw-semibold text-body-secondary mb-1">Enfermedades:</h6>
                <p class="mb-0">{{ pacient.sick ?: 'Ninguna registrada' }}</p>
            </div>
            <div class="mb-3">
                <h6 class="fw-semibold text-body-secondary mb-1">Medicamentos:</h6>
                <p class="mb-0">{{ pacient.medicaments ?: 'Ninguno registrado' }}</p>
            </div>
            <div>
                <h6 class="fw-semibold text-body-secondary mb-1">Alergias:</h6>
                <p class="mb-0 text-danger">{{ pacient.alergy ?: 'Ninguna registrada' }}</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i> Historial de Citas Médicas</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover">
                        <thead class="bg-body-tertiary">
                            <tr>
                                <th class="ps-4">Asunto / Cita</th>
                                <th>Médico</th>
                                <th>Fecha y Hora</th>
                                <th>Estatus</th>
                                <th class="text-end pe-4">PDF</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in reservations %}
                            <tr>
                                <td class="ps-4 fw-semibold">{{ reservation.title ?: 'Cita Médica' }}</td>
                                <td>
                                    {% set medic = reservation.getMedic() %}
                                    {{ medic ? 'Dr. ' ~ medic.name ~ ' ' ~ medic.lastname : 'N/A' }}
                                </td>
                                <td>{{ reservation.date_at }} {{ reservation.time_at }}</td>
                                <td>
                                    {% set status = reservation.getStatus() %}
                                    <span class="badge rounded-pill px-3 py-2 badge-status-{{ reservation.status_id }}">
                                        {{ status ? status.name : 'Pendiente' }}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="{{ base_url }}/reservation/{{ reservation.id }}/pdf" class="btn btn-sm btn-outline-danger" target="_blank"><i class="bi bi-file-pdf"></i></a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-4 text-body-secondary">Este paciente aún no tiene citas registradas.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
