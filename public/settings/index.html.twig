{% extends "layouts/main.html.twig" %}

{% block title %}Ajustes del Sistema - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><span>Análisis y Ajustes</span></li>
<li class="breadcrumb-item active"><span>Ajustes Generales</span></li>
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Ajustes Generales</h3>
        <p class="text-body-secondary mb-0">Configuración de parámetros y variables globales del sistema</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-gear-fill text-primary me-2"></i> Parámetros de Configuración</h5>
            </div>
            <div class="card-body p-4">
                <form action="{{ base_url }}/settings/update" method="POST">
                    {{ csrf_field() }}

                    {% for setting in settings %}
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">{{ setting.label }} <small class="text-body-secondary">({{ setting.name }})</small></label>
                        <input type="text" name="{{ setting.name }}" class="form-control" value="{{ setting.val }}">
                    </div>
                    {% else %}
                    <p class="text-body-secondary">No hay variables de configuración registradas.</p>
                    {% endfor %}

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle text-success me-2"></i> Agregar Nueva Variable</h5>
            </div>
            <div class="card-body p-4">
                <form action="{{ base_url }}/settings/create" method="POST">
                    {{ csrf_field() }}

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Slug / Clave *</label>
                        <input type="text" name="name" class="form-control" required placeholder="ej. system_title">
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Etiqueta / Nombre Visible *</label>
                        <input type="text" name="label" class="form-control" required placeholder="ej. Título del Sistema">
                    </div>

                    <div class="mb-4">
                        <label class="form-label font-weight-bold">Valor Inicial</label>
                        <input type="text" name="val" class="form-control" placeholder="ej. Mi Clínica">
                    </div>

                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-lg me-1"></i> Crear Variable</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
