{% extends "layouts/main.html.twig" %}

{% block title %}Editar Especialidad - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ base_url }}/categories">Especialidades</a></li>
<li class="breadcrumb-item active"><span>Editar Especialidad</span></li>
{% endblock %}

{% block content %}
<div class="mb-4">
    <a href="{{ base_url }}/categories" class="text-decoration-none text-body-secondary"><i class="bi bi-arrow-left me-1"></i> Volver a Especialidades</a>
    <h3 class="fw-bold mt-2">Editar Especialidad Médica</h3>
</div>

<div class="card border-0 shadow-sm col-md-6 mx-auto mb-4">
    <div class="card-body p-4">
        <form action="{{ base_url }}/category/{{ category.id }}/update" method="POST">
            {{ csrf_field() }}

            <div class="mb-4">
                <label class="form-label font-weight-bold">Nombre de la Especialidad *</label>
                <input type="text" name="name" class="form-control" required value="{{ category.name }}">
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="{{ base_url }}/categories" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Actualizar Especialidad</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
