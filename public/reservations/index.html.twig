{% extends "layouts/main.html.twig" %}

{% block title %}Agenda de Citas - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><span>Gestión Médica</span></li>
<li class="breadcrumb-item active"><span>Citas</span></li>
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Agenda de Citas Médicas</h3>
        <p class="text-body-secondary mb-0">Gestión de reservaciones y estatus de atención</p>
    </div>
    <a href="{{ base_url }}/reservation/new" class="btn btn-primary shadow-sm">
        <i class="bi bi-calendar-plus me-2"></i> + Agendar Nueva Cita
    </a>
</div>

<!-- Filtros rápidos de Citas -->
<div class="mb-4">
    <div class="btn-group shadow-sm rounded-pill overflow-hidden bg-body p-1" role="group">
        <a href="{{ base_url }}/reservations?filter=all" class="btn btn-sm {{ filter == 'all' or not filter ? 'btn-primary text-white' : 'btn-light text-body' }} px-4">Todas las Citas</a>
        <a href="{{ base_url }}/reservations?filter=pending" class="btn btn-sm {{ filter == 'pending' ? 'btn-primary text-white' : 'btn-light text-body' }} px-4">Citas Pendientes</a>
        <a href="{{ base_url }}/reservations?filter=old" class="btn btn-sm {{ filter == 'old' ? 'btn-primary text-white' : 'btn-light text-body' }} px-4">Historial Pasado</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-body-tertiary">
                    <tr>
                        <th class="ps-4">Asunto</th>
                        <th>Paciente</th>
                        <th>Médico</th>
                        <th>Fecha y Hora</th>
                        <th>Precio</th>
                        <th>Estatus</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">{{ reservation.title ?: 'Consulta Médica' }}</div>
                            <small class="text-body-secondary">{{ reservation.note }}</small>
                        </td>
                        <td>
                            {% set pacient = reservation.getPacient() %}
                            {% if pacient %}
                                <a href="{{ base_url }}/pacient/{{ pacient.id }}" class="text-decoration-none fw-semibold text-primary">{{ pacient.name }} {{ pacient.lastname }}</a>
                            {% else %}
                                <span class="text-body-secondary">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set medic = reservation.getMedic() %}
                            {% if medic %}
                                <a href="{{ base_url }}/medic/{{ medic.id }}" class="text-decoration-none text-body">Dr. {{ medic.name }} {{ medic.lastname }}</a>
                            {% else %}
                                <span class="text-body-secondary">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            <div><i class="bi bi-calendar3 me-1 text-body-secondary"></i> {{ reservation.date_at }}</div>
                            <small class="text-body-secondary"><i class="bi bi-clock me-1"></i> {{ reservation.time_at }}</small>
                        </td>
                        <td class="fw-semibold text-success">${{ reservation.price|number_format(2) }}</td>
                        <td>
                            <!-- Formulario de Cambio Rápido de Estado -->
                            <form action="{{ base_url }}/reservation/{{ reservation.id }}/status" method="POST" class="d-inline">
                                {{ csrf_field() }}
                                <select name="status_id" class="form-select form-select-sm border-0 bg-body-tertiary rounded-pill fw-bold" onchange="this.form.submit()">
                                    {% for status in statuses %}
                                        <option value="{{ status.id }}" {{ reservation.status_id == status.id ? 'selected' : '' }}>
                                            {{ status.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </form>
                        </td>
                        <td class="text-end pe-4">
                            <a href="{{ base_url }}/reservation/{{ reservation.id }}/pdf" class="btn btn-sm btn-outline-danger me-1" target="_blank" title="Imprimir PDF"><i class="bi bi-file-pdf"></i></a>
                            <a href="{{ base_url }}/reservation/{{ reservation.id }}/edit" class="btn btn-sm btn-outline-primary me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form action="{{ base_url }}/reservation/{{ reservation.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que deseas cancelar y eliminar esta cita?');">
                                {{ csrf_field() }}
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar / Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4 text-body-secondary">No hay citas agendadas registradas.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
