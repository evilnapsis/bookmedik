{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Paciente - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ base_url }}/pacients">Pacientes</a></li>
<li class="breadcrumb-item active"><span>Nuevo Paciente</span></li>
{% endblock %}

{% block content %}
<div class="mb-4">
    <a href="{{ base_url }}/pacients" class="text-decoration-none text-body-secondary"><i class="bi bi-arrow-left me-1"></i> Volver a Pacientes</a>
    <h3 class="fw-bold mt-2">Registrar Nuevo Paciente</h3>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form action="{{ base_url }}/pacient/create" method="POST">
            {{ csrf_field() }}

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">No. Expediente / ID</label>
                    <input type="text" name="no" class="form-control" placeholder="Ej. PAC-001">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Nombre *</label>
                    <input type="text" name="name" class="form-control" required placeholder="Nombre del paciente">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Apellido *</label>
                    <input type="text" name="lastname" class="form-control" required placeholder="Apellido del paciente">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Género</label>
                    <select name="gender" class="form-select">
                        <option value="m">Masculino</option>
                        <option value="f">Femenino</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Fecha de Nacimiento</label>
                    <input type="date" name="day_of_birth" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Teléfono</label>
                    <input type="text" name="phone" class="form-control" placeholder="Teléfono de contacto">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label font-weight-bold">Correo Electrónico</label>
                    <input type="email" name="email" class="form-control" placeholder="correo@ejemplo.com">
                </div>
                <div class="col-md-6">
                    <label class="form-label font-weight-bold">Dirección</label>
                    <input type="text" name="address" class="form-control" placeholder="Dirección de residencia">
                </div>
            </div>

            <hr class="my-4">

            <h5 class="fw-bold mb-3"><i class="bi bi-file-medical text-primary me-2"></i> Antecedentes Médicos</h5>
            
            <div class="mb-3">
                <label class="form-label font-weight-bold">Enfermedades / Padecimientos</label>
                <textarea name="sick" class="form-control" rows="2" placeholder="Describa enfermedades previa..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold">Medicamentos Actuales</label>
                <textarea name="medicaments" class="form-control" rows="2" placeholder="Medicamentos habituales..."></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label font-weight-bold">Alergias</label>
                <textarea name="alergy" class="form-control" rows="2" placeholder="Alergias conocidas..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="{{ base_url }}/pacients" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Guardar Paciente</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
