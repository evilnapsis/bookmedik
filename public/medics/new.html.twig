{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Médico - BookMedik v5{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ base_url }}/medics">Médicos</a></li>
<li class="breadcrumb-item active"><span>Nuevo Médico</span></li>
{% endblock %}

{% block content %}
<div class="mb-4">
    <a href="{{ base_url }}/medics" class="text-decoration-none text-body-secondary"><i class="bi bi-arrow-left me-1"></i> Volver a Médicos</a>
    <h3 class="fw-bold mt-2">Registrar Nuevo Médico</h3>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form action="{{ base_url }}/medic/create" method="POST">
            {{ csrf_field() }}

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">No. Licencia / ID</label>
                    <input type="text" name="no" class="form-control" placeholder="Ej. MED-101">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Nombre *</label>
                    <input type="text" name="name" class="form-control" required placeholder="Nombre del médico">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Apellido *</label>
                    <input type="text" name="lastname" class="form-control" required placeholder="Apellido del médico">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Especialidad / Categoría</label>
                    <select name="category_id" class="form-select">
                        <option value="">-- Seleccionar Categoría --</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Género</label>
                    <select name="gender" class="form-select">
                        <option value="m">Masculino</option>
                        <option value="f">Femenino</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Fecha de Nacimiento</label>
                    <input type="date" name="day_of_birth" class="form-control">
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Correo Electrónico</label>
                    <input type="email" name="email" class="form-control" placeholder="medico@hospital.com">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Teléfono</label>
                    <input type="text" name="phone" class="form-control" placeholder="Teléfono de contacto">
                </div>
                <div class="col-md-4">
                    <label class="form-label font-weight-bold">Dirección / Consultorio</label>
                    <input type="text" name="address" class="form-control" placeholder="Consultorio o dirección">
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="{{ base_url }}/medics" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Guardar Médico</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
